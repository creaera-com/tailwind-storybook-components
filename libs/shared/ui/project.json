{
  "name": "ui",
  "projectType": "library",
  "sourceRoot": "libs/shared/ui/src",
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "options": {
        "project": "libs/shared/ui/ng-package.json",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json"
      },
      "outputs": ["{workspaceRoot}/dist/libs/shared/ui"]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "storybook:build",
        "tsConfig": "libs/shared/ui/tsconfig.spec.json",
        "watch": false,
        "include": ["**/*.spec.ts"]
      },
      "inputs": [
        "default",
        "{workspaceRoot}/libs/storybook/project.json",
        "{workspaceRoot}/tsconfig.base.json"
      ]
    }
  }
}
